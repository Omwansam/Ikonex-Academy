# Server
PORT=5000
NODE_ENV=development

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/ikonex_academy?schema=public"

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Optional: restrict CORS to your frontend origin (e.g. http://localhost:5173)
# FRONTEND_URL=http://localhost:5173
